      "sources": ["enciclopedia.fixture.example", "estatisticas.fixture.example"]
    },
    {
      "id": "MOEDA",
      "claim": "A moeda oficial de Moçambique é o metical (MZN).",
      "query": "moeda oficial de Moçambique metical",
      "pattern": "(?i)\\bmetical\\b\\s*\\(MZN\\)",
      "sources": ["enciclopedia.fixture.example", "estatisticas.fixture.example", "banco-central.fixture.example"]
    },
    {
      "id": "BANCO_CENTRAL",
      "claim": "O banco central emissor é o Banco de Moçambique.",
      "query": "banco central de Moçambique emissor",
      "pattern": "(?i)Banco de Moçambique[^.\\n]{0,40}\\bbanco central\\b",
      "sources": ["banco-central.fixture.example"]
    }
  ]
